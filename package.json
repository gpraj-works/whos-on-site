{
  "name": "route-board",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Field-service dispatch & real-time job tracking platform",
  "scripts": {
    "dev": "pnpm --parallel --recursive dev",
    "dev:api": "pnpm --filter @routeboard/api dev",
    "dev:web": "pnpm --filter @routeboard/web dev",
    "build": "pnpm --recursive build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive typecheck",
    "db:generate": "pnpm --filter @routeboard/api db:generate",
    "db:migrate": "pnpm --filter @routeboard/api db:migrate",
    "db:push": "pnpm --filter @routeboard/api db:push",
    "db:seed": "pnpm --filter @routeboard/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  },
  "packageManager": "pnpm@10.27.0"
}
