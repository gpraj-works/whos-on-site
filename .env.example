NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://whosonsite:whosonsite_secret_password@localhost:5432/whosonsite
REDIS_URL=redis://localhost:6379
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Docker Compose overrides (used only by `docker compose up`)
# Inside the compose network the API reaches Postgres/Redis via the service
# hostnames `postgres` and `redis`, so these values are wired in compose.
POSTGRES_DB=whosonsite
POSTGRES_USER=whosonsite
POSTGRES_PASSWORD=whosonsite_secret_password
SEED_DATABASE=true